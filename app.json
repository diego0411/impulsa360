{
  "expo": {
    "name": "Impulsa360",
    "slug": "impulsa360",
    "version": "1.0.28",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#071223"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.integrat360.impulsa360",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Impulsa360 usa la cámara para capturar evidencias de activaciones.",
        "NSLocationWhenInUseUsageDescription": "Impulsa360 usa tu ubicación mientras utilizas la app para registrar el punto de activación.",
        "NSPhotoLibraryUsageDescription": "Impulsa360 permite seleccionar fotos de la biblioteca como evidencia de activaciones."
      }
    },
    "android": {
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.integrat360.impulsa360",
      "versionCode": 58,
      "blockedPermissions": [
  "android.permission.RECORD_AUDIO",
  "android.permission.READ_MEDIA_IMAGES",
  "android.permission.READ_MEDIA_VIDEO",
  "android.permission.WRITE_EXTERNAL_STORAGE"
]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "owner": "integrat360",
    "extra": {
      "eas": {
        "projectId": "001c3d4e-a378-4ba9-ac48-27f8c482d88e"
      }
    },
    "plugins": [
      "expo-asset",
      "./plugins/withAndroidNoBackup",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Impulsa360 usa la cámara para capturar evidencias de activaciones.",
          "recordAudioAndroid": false
        }
      ]
    ]
  }
}
